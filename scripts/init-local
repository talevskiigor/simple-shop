#!/usr/bin/env python3
"""Create non-production settings without reading or modifying the existing .env."""
import base64
import os
from pathlib import Path
import secrets

root = Path(__file__).resolve().parent.parent
destination = root / '.env.docker'
if destination.exists():
    raise SystemExit('.env.docker already exists; keeping its credentials and settings.')
private = root / '.private'
private.mkdir(mode=0o700, exist_ok=True)
root_password = private / 'database-root-password'
if root_password.exists():
    raise SystemExit('Existing database root credential found; restore .env.docker rather than resetting credentials.')

settings = {
    'COMPOSE_PROJECT_NAME': 'forkids-local', 'APP_PORT': '8088',
    'LOCAL_UID': str(os.getuid()), 'LOCAL_GID': str(os.getgid()),
    'APP_NAME': 'ForKIDS Local', 'APP_ENV': 'local',
    'APP_KEY': 'base64:' + base64.b64encode(secrets.token_bytes(32)).decode(),
    'APP_DEBUG': 'true', 'APP_URL': 'http://localhost:8088', 'STORE_SANDBOX': 'true',
    'LOG_CHANNEL': 'daily', 'LOG_LEVEL': 'warning',
    'DB_CONNECTION': 'mysql', 'DB_HOST': 'db', 'DB_PORT': '3306',
    'DB_DATABASE': 'local_forkids', 'DB_USERNAME': 'local_forkids',
    'DB_PASSWORD': secrets.token_hex(24),
    'DATABASE_URL': '', 'DB_SOCKET': '',
    'BROADCAST_DRIVER': 'log', 'CACHE_DRIVER': 'file', 'FILESYSTEM_DISK': 'local',
    'QUEUE_CONNECTION': 'sync', 'SESSION_DRIVER': 'file', 'SESSION_LIFETIME': '120',
    'SESSION_COOKIE': 'forkids_local_session', 'SESSION_SECURE_COOKIE': 'false',
    'MAIL_MAILER': 'log', 'MAIL_FROM_ADDRESS': 'local@forkids.test',
    # Match the model's ASCII-normalized fields, including Cyrillic product names.
    'MAIL_FROM_NAME': 'ForKIDS Local', 'SCOUT_DRIVER': 'collection', 'SCOUT_QUEUE': 'false',
    'GOOGLE_DRIVE_CLIENT_ID': '', 'GOOGLE_DRIVE_CLIENT_SECRET': '',
    'GOOGLE_DRIVE_REFRESH_TOKEN': '', 'GOOGLE_DRIVE_FOLDER': '',
}
with destination.open('x', opener=lambda path, flags: os.open(path, flags, 0o600)) as handle:
    handle.write(''.join(f'{key}="{value}"\n' for key, value in settings.items()))
with root_password.open('x', opener=lambda path, flags: os.open(path, flags, 0o600)) as handle:
    handle.write(secrets.token_hex(32))
print('Created .env.docker with fresh isolated credentials. Run scripts/dev up -d --build.')
